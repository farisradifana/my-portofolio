{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "my-portofolio",
  "account_id": "8551a3e82bc26658f7b8f8721df145e3",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "observability": { "enabled": true },

  // The built site. Pages and images are served without running the Worker;
  // only /api/* reaches worker/index.ts.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },

  "routes": [
    // Workers Routes: the apex and www DNS records stay user-managed in the
    // Cloudflare dashboard and must be proxied (orange cloud).
    { "pattern": "farisradifana.my.id/*", "zone_name": "farisradifana.my.id" },
    { "pattern": "www.farisradifana.my.id/*", "zone_name": "farisradifana.my.id" }
  ],

  // Job applications for /dashboard. No database_id here: Wrangler creates the
  // database on the first deploy and keeps it linked to this Worker.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio-applications",
      "migrations_dir": "migrations"
    }
  ],

  // Contact form mail. The binding can only deliver to this one address, which
  // must be a verified destination address in Cloudflare Email Routing.
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "radifan.ahmad96@gmail.com" }
  ],

  "ratelimits": [
    // Contact form: 5 messages per minute per client address.
    { "name": "RL_CONTACT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // Token-protected endpoints: 30 requests per minute per client address.
    { "name": "RL_API", "namespace_id": "1002", "simple": { "limit": 30, "period": 60 } }
  ],

  "vars": {
    "CONTACT_FROM": "contact@farisradifana.my.id",
    "CONTACT_TO": "radifan.ahmad96@gmail.com"
  }

  // Secrets are not listed here. Set them once with:
  //   npx wrangler secret put DASHBOARD_READ_TOKEN
  //   npx wrangler secret put INGEST_TOKEN
}
