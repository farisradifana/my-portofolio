{
  "name": "my-portofolio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check && tsc --noEmit -p worker",
    "test": "vitest run",
    "deploy": "astro build && wrangler deploy",
    "sync-tracker": "node --env-file-if-exists=.env scripts/sync-tracker.mjs",
    "export-public": "node --env-file-if-exists=.env scripts/export-public.mjs",
    "publish-dashboard": "node --env-file-if-exists=.env scripts/publish-dashboard.mjs"
  },
  "dependencies": {
    "astro": "^7.4.12",
    "embla-carousel": "^8.6.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@types/node": "^26.6.6",
    "lucide-static": "^1.73.0",
    "simple-icons": "^16.37.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "workerd@1.20261113.1": true,
    "esbuild@0.28.2": true
  }
}
