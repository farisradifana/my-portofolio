# Copy to .dev.vars for `npm run preview` (wrangler dev). Never commit real values.
# In production these are Worker secrets:
#   npx wrangler secret put DASHBOARD_READ_TOKEN
#   npx wrangler secret put INGEST_TOKEN
# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# Read access to the private dashboard view (GET /api/applications).
DASHBOARD_READ_TOKEN=replace-with-a-long-random-string

# Write access for apply-job-daily (POST /api/applications).
INGEST_TOKEN=replace-with-a-different-long-random-string

# --- Used only by scripts/sync-tracker.mjs, on the machine that runs apply-job-daily ---
# PORTFOLIO_URL=https://farisradifana.my.id
# TRACKER_CSV=F:\apply-job\ai-job-apply\data\tracker.csv
