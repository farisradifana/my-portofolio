---
import '../styles/global.css';
import interUrl from '../assets/inter.woff2?url';
import groteskUrl from '../assets/space-grotesk.woff2?url';
import Icon from '../components/Icon.astro';
import { nav, site } from '../data/site';
import { socials } from '../data/socials';

interface Props {
  title?: string;
  description?: string;
  /** Path of this page, used for the canonical URL. */
  path?: string;
  noindex?: boolean;
}
const { title = site.title, description = site.description, path = '/', noindex = false } = Astro.props;
const canonical = new URL(path, site.url).href;
const ogImage = new URL('/og.png', site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.url}/#person`,
      name: site.name,
      url: site.url,
      image: ogImage,
      jobTitle: 'Data Analyst',
      description: site.description,
      email: `mailto:${site.email}`,
      address: { '@type': 'PostalAddress', addressLocality: 'Yogyakarta', addressCountry: 'ID' },
      alumniOf: { '@type': 'CollegeOrUniversity', name: 'Telkom University' },
      knowsAbout: ['SQL', 'PostgreSQL', 'Power BI', 'Python', 'Tableau', 'BigQuery', 'KNIME', 'n8n', 'Business Intelligence'],
      sameAs: socials.filter((s) => s.href.startsWith('https://')).map((s) => s.href),
    },
    {
      '@type': 'ProfilePage',
      '@id': `${site.url}/#profile`,
      url: site.url,
      name: site.title,
      inLanguage: 'en',
      mainEntity: { '@id': `${site.url}/#person` },
    },
  ],
};
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#0b0f14" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={groteskUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />
    <script is:inline src="/theme-init.js"></script>
    {
      !noindex && (
        <>
          <meta property="og:type" content="profile" />
          <meta property="og:site_name" content={site.name} />
          <meta property="og:title" content={title} />
          <meta property="og:description" content={description} />
          <meta property="og:url" content={canonical} />
          <meta property="og:image" content={ogImage} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta property="og:image:alt" content={`${site.name}, ${site.tagline}`} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:site" content="@farisradifana" />
          <meta name="twitter:title" content={title} />
          <meta name="twitter:description" content={description} />
          <meta name="twitter:image" content={ogImage} />
          <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
        </>
      )
    }
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="nav">
      <div class="wrap">
        <a class="brand" href="/#home" aria-label={`${site.name}, home`}>F<span>R</span></a>
        <nav aria-label="Primary">
          <ul class="nav-links" id="nav-links">
            {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </nav>
        <div class="nav-actions">
          <button class="icon-btn theme-toggle" type="button" id="theme-toggle" aria-label="Switch to light theme">
            <Icon name="sun" class="sun" />
            <Icon name="moon" class="moon" />
          </button>
          <a class="btn btn-primary nav-cta" href={site.cv} download>
            <Icon name="download" />Download CV
          </a>
          <button class="icon-btn menu-btn" type="button" id="menu-btn" aria-label="Open menu" aria-expanded="false" aria-controls="nav-links">
            <Icon name="menu" />
          </button>
        </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <a href="#main" class="btn btn-ghost"><Icon name="arrow-up" />Back to top</a>
      </div>
    </footer>

    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
