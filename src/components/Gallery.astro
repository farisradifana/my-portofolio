---
// Work-sample gallery for one role. Files are picked and ordered by filename
// (src/lib/gallery-match.ts), then converted to WebP: a 640px thumbnail and a
// full version capped at 1600px. Small sources are never upscaled.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { groupFiles, normalizeName, type GroupId } from '../lib/gallery-match';
import { galleryAlt, galleryTitles } from '../data/site';

interface Props {
  group: GroupId;
}
const { group } = Astro.props;

const modules = import.meta.glob<{ default: ImageMetadata }>('../assets/gallery/*.{jpg,jpeg,png,JPG,JPEG,PNG}', { eager: true });
const byName = new Map(Object.entries(modules).map(([path, mod]) => [path.split('/').pop()!, mod.default]));
const files = groupFiles([...byName.keys()])[group];

const items = await Promise.all(
  files.map(async (name) => {
    const src = byName.get(name)!;
    const alt = galleryAlt[normalizeName(name)];
    if (!alt) throw new Error(`Missing alt text for gallery image "${name}"`);
    const thumbW = Math.min(640, src.width);
    const fullW = Math.min(1600, src.width);
    const [thumb, full] = await Promise.all([
      getImage({ src, width: thumbW, format: 'webp', quality: 72 }),
      getImage({ src, width: fullW, format: 'webp', quality: 80 }),
    ]);
    return {
      alt,
      thumb: thumb.src,
      thumbW,
      thumbH: Math.round((thumbW / src.width) * src.height),
      full: full.src,
      fullW,
      fullH: Math.round((fullW / src.width) * src.height),
    };
  }),
);
---

{
  items.length > 0 && (
    <>
      <ul class="gallery" data-gallery aria-label={`${galleryTitles[group]} gallery`}>
        {items.map((item, i) => (
          <li>
            <a href={item.full} data-full data-w={item.fullW} data-h={item.fullH} aria-label={`Open image ${i + 1} of ${items.length}: ${item.alt}`}>
              <img src={item.thumb} alt={item.alt} width={item.thumbW} height={item.thumbH} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    </>
  )
}
