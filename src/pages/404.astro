---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Faris Radifan Ahmad" description="This page does not exist." path="/404/" noindex>
  <section class="section">
    <div class="wrap">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lede">The address may be mistyped, or the page has moved.</p>
      <p style="margin-top: 32px"><a class="btn btn-primary" href="/">Back to the home page</a></p>
    </div>
  </section>
</Base>
